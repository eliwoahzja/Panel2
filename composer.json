{
  "name": "eliwoahzja/shai-panel",
  "description": "SHAI Panel - CodeIgniter 4 application with SHAI DDoS protection library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^7.3 || ^8.0",
    "ext-mysqli": "*",
    "ext-mbstring": "*",
    "codeigniter4/framework": "^4",
    "cleantalk/anti-ddos-lite": "^2.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "autoload": {
    "psr-4": {
      "Cleantalk\\CleantalkAntiDdosLite\\": "/",
      "App\\": "app",
      "Config\\": "app/Config"
    }
  },
  "config": {
    "optimize-autoloader": true
  }
}
