{
  "name": "eliwoahzja/shai-panel",
  "description": "SHAI Panel - CodeIgniter 4 application with SHAI DDoS protection library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^7.3 || ^8.0",
    "ext-mysqli": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "codeigniter4/framework": "v4.1.9",
    "kint-php/kint": "^4.0",
    "laminas/laminas-escaper": "^2.9",
    "psr/log": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app",
      "Config\\": "app/Config"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform-check": false,
    "platform": {
      "php": "7.3.0"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}